---
interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}
// .astro pages pass title/description directly (<BaseLayout title="..." description="...">);
// Markdown pages using `layout:` in frontmatter get all their frontmatter nested under
// Astro.props.frontmatter instead -- support both call conventions rather than picking one
// and silently breaking the other.
const { title, description, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? '';
const pageDescription =
  description ??
  frontmatter?.description ??
  'Free, no-account, no-server tools for opting out of data brokers and hardening your devices. Nothing leaves your browser -- verify it yourself.';
const fullTitle = `${pageTitle} — Make Yourself Expensive`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/og-image.png', Astro.site).toString();

// GitHub Pages can't set response headers, so this is enforced via <meta http-equiv> instead
// of a real Content-Security-Policy header. That has two real gaps worth naming: (1)
// frame-ancestors is ignored entirely in a meta CSP (clickjacking protection needs a real
// header -- would need a proxy like Cloudflare in front of Pages), and (2) meta CSP can't set
// report-uri/report-to. What it DOES enforce: connect-src 'self' plausible.io makes "nothing
// leaves your browser except aggregate page-view pings to Plausible" a browser-enforced
// guarantee, not just a claim to take on faith -- open devtools and try to fetch() any OTHER
// external origin from this page and watch it get blocked. script-src/style-src need
// 'unsafe-inline' because Astro inlines its island-hydration bootstrap script and Svelte
// components set dynamic inline styles (e.g. the guided-batch progress bar) -- a static host
// with no per-request nonce can't do better than that without a hash-per-build scheme, which
// isn't worth the fragility here. plausible.io is allowlisted narrowly on script-src (to load
// the snippet) and connect-src (to POST the page-view ping) -- see ANALYTICS.md for exactly
// what it does and doesn't collect.
const CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://plausible.io",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self'",
  "connect-src 'self' https://plausible.io",
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Make Yourself Expensive" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!--
      Plausible: aggregate, cookie-free page-view analytics. Page views only -- no custom
      events are ever fired from broker rows, the hardening checklist, or anywhere else that
      could reconstruct which brokers/hardening items a specific visitor interacted with. See
      ANALYTICS.md for the full scope of what this does and doesn't collect.
    -->
    <script is:inline async src="https://plausible.io/js/pa-UDekj5lRuXWHXzw3ZI4Km.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        };
      plausible.init = plausible.init || function (i) {
        plausible.o = i || {};
      };
      plausible.init();
    </script>
  </head>
  <body>
    <!-- First focusable element on every page. The nav plus the alpha banner occupy ~167px
         before content on a phone, and /brokers renders 493 rows -- without this, reaching the
         list by keyboard means tabbing the whole nav on every single page load. Visually hidden
         until focused, then it appears. -->
    <a class="skip-link" href="#main">Skip to main content</a>
    <nav class="site-nav">
      <a href="/" class="brand">
        <span class="brand-full">Make Yourself Expensive</span>
        <span class="brand-short">MYE</span>
      </a>
      <!-- Opt-Out points at the guided flow, not the full 493-row list. The batching in
           lib/batching/nextBatch.ts orders by value x ease, so the first four batches a new
           reader meets are verified, live-link, crucial entries -- the best first sitting the
           data can offer. Nothing routed anyone there: the nav and both homepage links went to
           the full list, and the guided flow was reachable only via a callout partway down it.
           The full list stays one click away from both /brokers/guide/ and the footer, for
           anyone who wants to search or revisit a specific broker. -->
      <div class="nav-links">
        <a href="/profile">Profile</a>
        <a href="/brokers/guide/">Opt-Out</a>
        <a href="/harden/">Harden</a>
        <a href="/resources">Resources</a>
      </div>
    </nav>
    <!-- Alpha banner, not a fifth nav item. The nav is the tool's spine (Profile -> Opt-Out
         -> Harden -> Resources) and a permanent "Testing" entry would read as clutter to the
         general audience this is for. A banner tells every visitor the true thing -- this is
         unfinished -- and routes the willing to /testing. Delete this block when alpha ends. -->
    <!-- Kept to one line on a phone: the previous wording wrapped to two and cost 80px of the
         first screen. Same promise, fewer words. -->
    <aside class="alpha-banner">
      <strong>Alpha.</strong> Some broker instructions are unverified.
      <a href="/testing">How to test it and report what you find</a>
    </aside>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <a href="/brokers">Full broker list</a>
      <span aria-hidden="true">·</span>
      <a href="/testing">Testing &amp; feedback</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/markramm/make-yourself-expensive">Source</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/markramm/data-broker-registry">Broker dataset</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ede9e0;
    --ink: #16130e;
    --seal: #8a1c1c;
    --graphite: #6b6459;
    --rule: #c9c1b2;
    /* Filled-surface variants: the colour drawn BEHIND white text (priority badges, primary
       buttons, the integrity banner), as distinct from --seal/--graphite, which are text
       colours drawn ON paper. In light mode the two coincide; in dark mode they must not --
       see the dark block for the measurements. */
    --seal-surface: #8a1c1c;
    --graphite-surface: #6b6459;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #16130e;
      --ink: #ede9e0;
      --rule: #443f36;
      /* --seal and --graphite MUST be redefined here, not inherited from the light block.
         The light values are chosen against #ede9e0 paper; against dark paper they collapse:
         #8a1c1c scored 2.0:1 and #6b6459 scored 3.17:1 (measured), so every body link, the
         UNVERIFIED badge, and -- because :focus-visible draws its outline in --seal -- the
         keyboard focus ring were all below WCAG AA. Dark mode is the default on most
         machines, so this was the common case, not the edge case.
         These two are the same hues lightened until they clear AA (4.5:1 for text) and the
         3:1 non-text minimum for the focus ring. */
      --seal: #e8836a;
      --graphite: #a89f92;
      /* The filled-surface variants deliberately DO NOT track --seal/--graphite here. Those
         two are lightened so they clear AA as TEXT on dark paper, but that same lightening
         destroys the contrast of the white text sitting ON them: white measured 2.66:1 on
         #e8836a and 2.61:1 on #a89f92, both under the 4.5:1 floor, across the crucial/high
         priority badges, the integrity banner, the level-up and save/apply buttons, and the
         guardrail confirm. Dark mode is the default on most machines, so this was the common
         case. These values clear AA for the white text (5.50:1 and 5.67:1) while still
         standing off the dark paper (3.37:1 and 3.27:1) so a filled badge stays visible as a
         shape -- a surface tuned only for its text can sink into the background instead. */
      --seal-surface: #b44434;
      --graphite-surface: #6c665f;
    }
  }
  * {
    box-sizing: border-box;
  }
  :focus-visible {
    outline: 2px solid var(--seal);
    outline-offset: 2px;
  }
  .skip-link {
    position: absolute;
    left: 0.5rem;
    top: -4rem;
    z-index: 200;
    background: var(--paper);
    color: var(--seal);
    border: 1px solid var(--seal);
    border-radius: 3px;
    padding: 0.6rem 0.9rem;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    /* Off-screen rather than display:none -- it has to stay focusable to be reachable. */
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 0.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
  main:focus {
    outline: none;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.5;
  }
  .alpha-banner {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--seal) 8%, var(--paper));
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .alpha-banner a {
    color: var(--seal);
    white-space: nowrap;
  }
  .site-footer {
    margin-top: 3rem;
    padding: 1.25rem 1rem 2rem;
    border-top: 1px solid var(--rule);
    font-size: 0.85rem;
    color: var(--graphite);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    font-family: 'Courier New', monospace;
  }
  /* Nav links carried a 22px touch height (the brand 24px) against a 44px mobile-accessibility
     floor -- the site's spine was the hardest thing on the page to hit with a thumb. Grow the
     hit area with padding and pull it back with negative margin, so the tap target changes and
     the visual rhythm of the bar does not. Same technique as .check-target in RowShell.svelte. */
  .site-nav a {
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.15rem;
    margin: -0.6rem 0;
  }
  .site-nav .brand {
    font-weight: bold;
    white-space: nowrap;
  }
  .brand-short {
    display: none;
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  @media (max-width: 420px) {
    .brand-full {
      display: none;
    }
    .brand-short {
      display: inline;
    }
    .nav-links {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem;
  }

  /* Prose styling for Markdown-rendered guide content (src/pages/harden/*.md) */
  main h1 {
    font-size: 1.7rem;
    line-height: 1.25;
  }
  main h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.3rem;
  }
  main p,
  main li {
    line-height: 1.6;
  }
  main blockquote {
    border-left: 3px solid var(--seal);
    margin: 1rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--graphite);
  }
  main a {
    color: var(--seal);
  }
  main code {
    font-family: 'Courier New', monospace;
    background: var(--rule);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
    font-size: 0.9em;
  }
  main hr {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 2rem 0;
  }
</style>
