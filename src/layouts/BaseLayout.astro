---
interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}
// .astro pages pass title/description directly (<BaseLayout title="..." description="...">);
// Markdown pages using `layout:` in frontmatter get all their frontmatter nested under
// Astro.props.frontmatter instead -- support both call conventions rather than picking one
// and silently breaking the other.
const { title, description, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? '';
const pageDescription =
  description ??
  frontmatter?.description ??
  'Free, no-account, no-server tools for opting out of data brokers and hardening your devices. Nothing leaves your browser -- verify it yourself.';
const fullTitle = `${pageTitle} — Make Yourself Expensive`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/og-image.png', Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Make Yourself Expensive" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <nav class="site-nav">
      <a href="/" class="brand">
        <span class="brand-full">Make Yourself Expensive</span>
        <span class="brand-short">MYE</span>
      </a>
      <div class="nav-links">
        <a href="/brokers">Opt-Out</a>
        <a href="/harden/">Harden</a>
        <a href="/resources">Resources</a>
        <a href="/profile">Profile</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ede9e0;
    --ink: #16130e;
    --seal: #8a1c1c;
    --graphite: #6b6459;
    --rule: #c9c1b2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #16130e;
      --ink: #ede9e0;
      --rule: #443f36;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.5;
  }
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    font-family: 'Courier New', monospace;
  }
  .site-nav a {
    color: var(--ink);
    text-decoration: none;
  }
  .site-nav .brand {
    font-weight: bold;
    white-space: nowrap;
  }
  .brand-short {
    display: none;
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  @media (max-width: 420px) {
    .brand-full {
      display: none;
    }
    .brand-short {
      display: inline;
    }
    .nav-links {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem;
  }

  /* Prose styling for Markdown-rendered guide content (src/pages/harden/*.md) */
  main h1 {
    font-size: 1.7rem;
    line-height: 1.25;
  }
  main h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.3rem;
  }
  main p,
  main li {
    line-height: 1.6;
  }
  main blockquote {
    border-left: 3px solid var(--seal);
    margin: 1rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--graphite);
  }
  main a {
    color: var(--seal);
  }
  main code {
    font-family: 'Courier New', monospace;
    background: var(--rule);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
    font-size: 0.9em;
  }
  main hr {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 2rem 0;
  }
</style>
