---
interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
}
// .astro pages pass title/description directly (<BaseLayout title="..." description="...">);
// Markdown pages using `layout:` in frontmatter get all their frontmatter nested under
// Astro.props.frontmatter instead -- support both call conventions rather than picking one
// and silently breaking the other.
const { title, description, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? '';
const pageDescription =
  description ??
  frontmatter?.description ??
  'Free, no-account, no-server tools for opting out of data brokers and hardening your devices. Nothing leaves your browser -- verify it yourself.';
const fullTitle = `${pageTitle} — Make Yourself Expensive`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/og-image.png', Astro.site).toString();

// GitHub Pages can't set response headers, so this is enforced via <meta http-equiv> instead
// of a real Content-Security-Policy header. That has two real gaps worth naming: (1)
// frame-ancestors is ignored entirely in a meta CSP (clickjacking protection needs a real
// header -- would need a proxy like Cloudflare in front of Pages), and (2) meta CSP can't set
// report-uri/report-to. What it DOES enforce: connect-src 'self' plausible.io makes "nothing
// leaves your browser except aggregate page-view pings to Plausible" a browser-enforced
// guarantee, not just a claim to take on faith -- open devtools and try to fetch() any OTHER
// external origin from this page and watch it get blocked. script-src/style-src need
// 'unsafe-inline' because Astro inlines its island-hydration bootstrap script and Svelte
// components set dynamic inline styles (e.g. the guided-batch progress bar) -- a static host
// with no per-request nonce can't do better than that without a hash-per-build scheme, which
// isn't worth the fragility here. plausible.io is allowlisted narrowly on script-src (to load
// the snippet) and connect-src (to POST the page-view ping) -- see ANALYTICS.md for exactly
// what it does and doesn't collect.
const CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://plausible.io",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self'",
  "connect-src 'self' https://plausible.io",
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Make Yourself Expensive" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!--
      Plausible: aggregate, cookie-free page-view analytics. Page views only -- no custom
      events are ever fired from broker rows, the hardening checklist, or anywhere else that
      could reconstruct which brokers/hardening items a specific visitor interacted with. See
      ANALYTICS.md for the full scope of what this does and doesn't collect.
    -->
    <script is:inline async src="https://plausible.io/js/pa-UDekj5lRuXWHXzw3ZI4Km.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        };
      plausible.init = plausible.init || function (i) {
        plausible.o = i || {};
      };
      plausible.init();
    </script>
  </head>
  <body>
    <nav class="site-nav">
      <a href="/" class="brand">
        <span class="brand-full">Make Yourself Expensive</span>
        <span class="brand-short">MYE</span>
      </a>
      <div class="nav-links">
        <a href="/profile">Profile</a>
        <a href="/brokers">Opt-Out</a>
        <a href="/harden/">Harden</a>
        <a href="/resources">Resources</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ede9e0;
    --ink: #16130e;
    --seal: #8a1c1c;
    --graphite: #6b6459;
    --rule: #c9c1b2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #16130e;
      --ink: #ede9e0;
      --rule: #443f36;
    }
  }
  * {
    box-sizing: border-box;
  }
  :focus-visible {
    outline: 2px solid var(--seal);
    outline-offset: 2px;
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.5;
  }
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    font-family: 'Courier New', monospace;
  }
  .site-nav a {
    color: var(--ink);
    text-decoration: none;
  }
  .site-nav .brand {
    font-weight: bold;
    white-space: nowrap;
  }
  .brand-short {
    display: none;
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  @media (max-width: 420px) {
    .brand-full {
      display: none;
    }
    .brand-short {
      display: inline;
    }
    .nav-links {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 1.5rem;
  }

  /* Prose styling for Markdown-rendered guide content (src/pages/harden/*.md) */
  main h1 {
    font-size: 1.7rem;
    line-height: 1.25;
  }
  main h2 {
    font-size: 1.25rem;
    margin-top: 2rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.3rem;
  }
  main p,
  main li {
    line-height: 1.6;
  }
  main blockquote {
    border-left: 3px solid var(--seal);
    margin: 1rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    color: var(--graphite);
  }
  main a {
    color: var(--seal);
  }
  main code {
    font-family: 'Courier New', monospace;
    background: var(--rule);
    padding: 0.1rem 0.3rem;
    border-radius: 2px;
    font-size: 0.9em;
  }
  main hr {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 2rem 0;
  }
</style>
