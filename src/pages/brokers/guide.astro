---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuidedBatch from '../../components/GuidedBatch.svelte';
---

<BaseLayout
  title="Guided Opt-Out"
  description="Work through data broker opt-outs a few at a time, in sensible order -- one sitting at a time, free, no account."
>
  <h1>Opt out, a few at a time</h1>
  <p class="intro">
    Working in order of what matters most — highest value and easiest first. Check one off and
    the list gets shorter. Come back whenever; your progress stays in this browser.
  </p>
  <p class="intro secondary">
    <a href="/brokers">See all brokers</a>
    · <a href="/switch-devices">Switching devices?</a>
    · <a href="/harden/">Harden your devices too</a>
  </p>
  <GuidedBatch client:load />
</BaseLayout>

<style>
  .intro {
    color: var(--graphite, #6b6459);
    font-size: 0.95rem;
  }
  .secondary {
    font-size: 0.9rem;
  }
</style>
